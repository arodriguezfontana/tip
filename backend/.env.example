PROJECT_NAME="TIP"
API_V1_STR="/api/v1"

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=contraseña_local
POSTGRES_DB=tip

DATABASE_URL=postgresql://postgres:contraseña_local@localhost:5432/tip

# Canales por los que atiende el bot: telegram, whatsapp o ambos separados por coma (telegram,whatsapp)
BOT_CHANNELS=telegram

# Telegram (requerido si BOT_CHANNELS incluye telegram)
TELEGRAM_TOKEN=token_de_botfather

# WhatsApp Cloud API (requerido si BOT_CHANNELS incluye whatsapp). Ver backend/docs/whatsapp.md
WHATSAPP_ACCESS_TOKEN=token_de_acceso_permanente
WHATSAPP_PHONE_NUMBER_ID=id_del_numero_de_telefono
WHATSAPP_VERIFY_TOKEN=un_texto_secreto_que_elegis_vos
WHATSAPP_APP_SECRET=clave_secreta_de_la_app_de_meta

PUBLIC_URL=https://tu-dominio.ngrok-free.app

# API key de Google AI Studio para usar Gemini vía langchain-google-genai
GOOGLE_API_KEY=tu_api_key_de_google

# Autenticación JWT del panel de administración
JWT_SECRET_KEY=cambiar_por_un_secreto_largo_y_aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Credenciales del dueño del local
ADMIN_EMAIL=admin@restoit.com
ADMIN_PASSWORD=cambiar_esta_password

# MercadoPago (Access Token de prueba o producción obtenido en developers.mercadopago.com)
MERCADOPAGO_ACCESS_TOKEN=TEST-tu-access-token-o-APP_USR-tu-access-token